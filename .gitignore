# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Data directories (repo root only — do NOT ignore tests/data/)
/data/
/UPLOADS/

# Environment/secrets
.env
.env.*
auth.yaml
.streamlit/secrets.toml

# OS
.DS_Store

# Backup files
*.backup
*.bak
*.old

# Debug/test scripts (one-off) - any level
debug_*.py
test_*.py
verify_*.py
tune_iteration.py
check_rate.py
fix_*.py
props_model_new.py

# Redundant scripts (should be in scripts/ if reusable)

# Logs and outputs
*.log

# Temporary
tmp/
temp/

# The REAL test suite must be tracked (overrides debug/test name patterns above).
# Without these lines, test_*.py silently excluded tests/test_grading.py from
# the safeguards commit and CI found "file or directory not found".
!tests/
!tests/**
# ...but never byte-code caches inside tests/
tests/**/__pycache__/